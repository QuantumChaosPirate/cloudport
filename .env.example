# ── Azure Storage ─────────────────────────────────────────────────────────────
AZURE_STORAGE_CONNECTION_STRING=your-azure-storage-connection-string
AZURE_STORAGE_ACCOUNT_NAME=your-storage-account-name

# ── Database ──────────────────────────────────────────────────────────────────
DB_PASSWORD=change-this-to-a-strong-password

# ── Security ──────────────────────────────────────────────────────────────────
SECRET_KEY=change-this-to-a-long-random-string

# ── Domain ────────────────────────────────────────────────────────────────────
DOMAIN=yourdomain.com
CERTBOT_EMAIL=your-email@example.com

# ── Jellyfin ──────────────────────────────────────────────────────────────────
JELLYFIN_ADMIN_USERNAME=admin
JELLYFIN_ADMIN_PASSWORD=change-this-to-a-strong-password

# ── Grafana ───────────────────────────────────────────────────────────────────
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-this-to-a-strong-password

# ── Outline ───────────────────────────────────────────────────────────────────
OUTLINE_SECRET_KEY=change-this-to-a-long-random-string
OUTLINE_UTILS_SECRET=change-this-to-a-long-random-string
